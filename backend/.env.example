# Local development uses backend/data/model_lab.db automatically.
# For Turso, set both values below in Render.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The public Vercel origin. Comma-separate preview origins if needed.
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=30
# Set false after creating your personal account if nobody else should register.
ALLOW_REGISTRATION=true
# Required in production; share the setup code privately with the owner only.
APP_ENV=development
OWNER_EMAIL=
REGISTRATION_TOKEN=
